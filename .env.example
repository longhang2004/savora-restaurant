# ─────────────────────────────────────────────────────────────
# Savora Restaurant — environment variables (copy to .env.local)
# NEVER commit real credentials. All values here are placeholders.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL or any Postgres 15+) ──
# Required. Example (Supabase):
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ── Session signing ──
# Required. At least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Stripe (test mode for development) ──
# Optional — checkout falls back to sandbox payment when unset AND DEMO_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (transactional email) ──
# Optional — emails are logged and skipped when unset
RESEND_API_KEY=
# Used as the From address for transactional emails, e.g. Savora <reservations@savora.vn>
RESEND_FROM_EMAIL=

# ── Supabase Auth (admin sign-in) ──
# Optional — required for production admin auth. Demo mode works without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site URL ──
# Optional — defaults to https://savora-restaurant.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Demo / local mode ──
# DEMO_MODE=true enables:
#   • sandbox payment (simulates the Stripe webhook locally)
#   • demo admin sign-in with DEMO_ADMIN_EMAIL/DEMO_ADMIN_PASSWORD
# Never enable DEMO_MODE in production.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@savora.vn
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_DISPLAY_NAME=Restaurant Manager
